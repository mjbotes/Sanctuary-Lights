{
  "name": "sanctuary-lights",
  "version": "1.0.0",
  "description": "Church lighting controller with backing tracks, live auto-tune, 3D stage and MIDI.",
  "main": "electron/main.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@julusian/midi": "^3.9.0"
  },
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "test:ui": "node test/ui/smoke.js"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "productName": "Sanctuary Lights",
  "author": "Sanctuary Lights",
  "build": {
    "appId": "app.sanctuarylights.controller",
    "productName": "Sanctuary Lights",
    "copyright": "Sanctuary Lights contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "lib/**",
      "public/**",
      "electron/**",
      "package.json",
      "README.md",
      "LICENSE",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Sanctuary Lights uses audio inputs for live vocals and auto-tune.",
        "NSLocalNetworkUsageDescription": "Sanctuary Lights sends lighting data (Art-Net / sACN) and lets iPads connect on your network."
      }
    },
    "dmg": {
      "title": "Sanctuary Lights ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sanctuary Lights"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png"
    },
    "artifactName": "Sanctuary-Lights-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "mjbotes",
        "repo": "Sanctuary-Lights",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
